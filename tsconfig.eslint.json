{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "jsx": "react-jsx",
    "noEmit": true,
    "types": ["@cloudflare/vitest-pool-workers/types"]
  },
  "include": [
    "*.config.ts",
    "packages/*/*.config.ts",
    "packages/*/src/**/*.test.ts",
    "packages/*/src/**/*.test.tsx",
    "packages/worker/worker-configuration.d.ts"
  ]
}
