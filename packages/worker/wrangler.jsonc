{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "kryptex",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-20",
  "assets": {
    "binding": "ASSETS",
    "directory": "../web/dist/client",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  "vars": {
    "EXPECTED_ORIGIN": "http://localhost:5173",
    "TURNSTILE_EXPECTED_HOSTNAME": "localhost",
    "TURNSTILE_EXPECTED_ACTION": "create_permit",
    "CAPABILITY_ACTIVE_KEY_ID": "dev-v1",
    "PERMIT_ISSUANCE_ACTIVE_KEY_ID": "dev-v1"
  },
  "secrets": {
    "required": [
      "CAPABILITY_HMAC_KEYRING",
      "PERMIT_ISSUANCE_KEYRING",
      "RATE_LIMIT_KEY",
      "TURNSTILE_SECRET_KEY"
    ]
  },
  "durable_objects": {
    "bindings": [
      { "name": "SEND_OBJECTS", "class_name": "SendDurableObject" },
      { "name": "REQUEST_OBJECTS", "class_name": "RequestDurableObject" },
      { "name": "CREATE_PERMIT_OBJECTS", "class_name": "CreatePermitDurableObject" },
      { "name": "PAIRING_OBJECTS", "class_name": "PairingDurableObject" }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["SendDurableObject", "RequestDurableObject", "CreatePermitDurableObject"]
    },
    {
      "tag": "v2",
      "new_sqlite_classes": ["PairingDurableObject"]
    }
  ],
  "r2_buckets": [
    {
      "binding": "CIPHERTEXT",
      "bucket_name": "kryptex-ciphertext"
    }
  ],
  "ratelimits": [
    {
      "name": "EDGE_RATE_LIMITER",
      "namespace_id": "1454624106",
      "simple": {
        "limit": 120,
        "period": 60
      }
    },
    {
      "name": "LOCATOR_RATE_LIMITER",
      "namespace_id": "1454624107",
      "simple": {
        "limit": 30,
        "period": 60
      }
    }
  ]
}
