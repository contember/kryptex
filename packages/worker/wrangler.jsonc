{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "kryptex",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-20",
  "assets": {
    "binding": "ASSETS",
    "directory": "../web/dist/client",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "vars": {
    "EXPECTED_ORIGIN": "http://localhost:5173",
    "TURNSTILE_EXPECTED_HOSTNAME": "localhost",
    "TURNSTILE_EXPECTED_ACTION": "create_permit",
    "CAPABILITY_ACTIVE_KEY_ID": "dev-v1"
  },
  "durable_objects": {
    "bindings": [
      { "name": "SEND_OBJECTS", "class_name": "SendDurableObject" },
      { "name": "REQUEST_OBJECTS", "class_name": "RequestDurableObject" },
      { "name": "CREATE_PERMIT_OBJECTS", "class_name": "CreatePermitDurableObject" }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["SendDurableObject", "RequestDurableObject", "CreatePermitDurableObject"]
    }
  ],
  "r2_buckets": [
    {
      "binding": "CIPHERTEXT",
      "bucket_name": "kryptex-ciphertext"
    }
  ]
}
